# ==============================================================================
# SAFEPATH AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and provide your production API credentials.
# The platform functions smoothly in offline / smart-city fallback mode if keys
# are omitted, allowing evaluation and testing without required paid accounts.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND / CLIENT-SIDE ENVIRONMENT VARIABLES
# ------------------------------------------------------------------------------
# NOTE: Variables prefixed with VITE_ are embedded into the client-side JavaScript
# bundle and are visible to anyone inspecting the website in a web browser.
# 
# CRITICAL GOOGLE MAPS SECURITY INSTRUCTION:
# Restrict this API key in the Google Cloud Console (APIs & Services > Credentials):
#   - Application restrictions: HTTP referrers (e.g., http://localhost:8000/*, http://127.0.0.1:8000/*, yourdomain.com/*)
#   - API restrictions: Restrict key to "Maps JavaScript API" and "Directions API" only.
#
VITE_GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# 2. BACKEND / SERVER-SIDE ENVIRONMENT VARIABLES
# ------------------------------------------------------------------------------
# NOTE: Server-side keys are NEVER exposed to the frontend or browser.
# Keep these strictly confidential.

# Google Maps Server API Key (Optional — for server-to-server Directions & Geocoding)
GOOGLE_MAPS_API_KEY=

# TomTom Traffic API Key (Optional — for live intersection flow telemetry)
# Free tier key can be generated at: https://developer.tomtom.com/
TOMTOM_API_KEY=

# OpenWeatherMap API Key (Optional — Open-Meteo is used by default with zero key required)
OPENWEATHER_API_KEY=

# SafePath Database Path (Defaults to safepath.db in backend/)
SAFEPATH_DB_PATH=backend/safepath.db

# Server Host and Port
SAFEPATH_HOST=127.0.0.1
SAFEPATH_PORT=8000
